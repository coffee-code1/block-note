---
import { Icon } from "astro-icon/components";
import MainGridLayout from "../layouts/MainGridLayout.astro";
import { url } from "../utils/url-utils";

const title = "页面走丢了";
---

<MainGridLayout title={title} description="你访问的页面不存在或已被移动">
    <div class="flex w-full rounded-[var(--radius-large)] overflow-hidden relative mb-4">
        <div class="card-base z-10 px-6 md:px-9 py-14 md:py-20 relative w-full flex flex-col items-center text-center">
            <div class="transition text-[4rem] md:text-[5rem] leading-none font-bold text-[var(--primary)] mb-4">404</div>
            <div class="transition text-xl md:text-2xl font-bold text-90 mb-3">页面走丢了</div>
            <div class="transition text-75 mb-8 max-w-[26rem]">
                这个地址不存在，或者内容已经被移动到了别处。可以回到首页继续浏览，也可以用搜索找找看。
            </div>
            <div class="flex flex-col md:flex-row gap-3">
                <a href={url("/")}
                   class="btn-regular rounded-xl h-11 px-5 font-bold gap-2 active:scale-95">
                    <Icon name="material-symbols:home-outline-rounded" class="text-[1.25rem]"></Icon>
                    回到首页
                </a>
                <a href={url("/archive/")}
                   class="btn-regular rounded-xl h-11 px-5 font-bold gap-2 active:scale-95">
                    <Icon name="material-symbols:book-2-outline-rounded" class="text-[1.25rem]"></Icon>
                    浏览归档
                </a>
            </div>
        </div>
    </div>
</MainGridLayout>
