---
import { Icon } from "astro-icon/components";
---

<!-- There can't be a filter on parent element, or it will break `fixed` -->
<div class="back-to-top-wrapper hidden lg:block">
    <div id="back-to-top-btn" class="back-to-top-btn hide flex items-center rounded-2xl overflow-hidden transition" onclick="backToTop()">
        <button aria-label="Back to Top" class="btn-card h-[3.75rem] w-[3.75rem]">
            <Icon name="material-symbols:keyboard-arrow-up-rounded" class="mx-auto"></Icon>
        </button>
    </div>
</div>

<style lang="stylus">
.back-to-top-wrapper
    width: 3.75rem
    height: 3.75rem
    position: absolute
    right: 0
    top: 0
    pointer-events: none

.back-to-top-btn
    color: var(--primary)
    font-size: 2.25rem
    font-weight: bold
    border: none
    position: fixed
    bottom: 2rem
    right: 2rem
    z-index: 50
    opacity: 1
    cursor: pointer
    transform: translateY(0) scale(1)
    pointer-events: auto
    i
        font-size: 1.75rem
    &.hide
        transform: translateY(0.5rem) scale(0.9)
        opacity: 0
        pointer-events: none
    &:active
        transform: translateY(0) scale(0.9)

/* 宽屏文章页（右侧目录栏可见时）：按钮移到目录栏正下方，
   并相对目录栏水平居中（目录栏 13rem + 容器内边距 1rem，按钮宽 3.75rem） */
@media (min-width: 1280px)
    body.is-post .back-to-top-btn
        right: calc(max(0px, (100vw - var(--page-width))) / 2 + 5.625rem)

</style>

<script is:raw is:inline>
function backToTop() {
    window.scroll({ top: 0, behavior: 'smooth' });
}
</script>
