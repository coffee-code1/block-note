---
/**
 * 首页横幅标语：衬线字体 + 逐字渐入 + 缓慢呼吸辉光
 *
 * 性能：
 * 1. 纯 CSS，**零 JavaScript** —— 服务器不传任何脚本，也不占访客主线程。
 * 2. 呼吸只改 opacity（合成器处理），不动画 text-shadow —— 阴影动画会导致每帧重绘。
 * 3. 逐字渐入只动 opacity / transform，且**只跑一次**（非 infinite），跑完即停。
 * 4. 尊重 prefers-reduced-motion：此时不做动画，但标语仍静态显示（不影响阅读）。
 * 5. 横幅层不在 Swup 替换范围内，用 body 的 lg:is-home 控制显隐，切页不会残留。
 */

import { siteConfig } from "../../config";

// 标语内容：想换直接改这里
const SLOGAN = "且将新火试新茶，诗酒趁年华";
// 下方小字：站点副标题
const SUBTITLE = "Welcome---Friends";

// 逐字拆分（Array.from 能正确处理生僻字 / 代理对）
const CHARS = Array.from(SLOGAN);
---

<div id="banner-slogan" aria-hidden="true" style={`--n:${CHARS.length}`}>
    <div class="slogan-box">
        <div class="slogan-main">
            {CHARS.map((ch, i) => (
                <span class="slogan-char" style={`--i:${i}`}>{ch}</span>
            ))}
        </div>
        <div class="slogan-sub">{SUBTITLE}</div>
    </div>
</div>

<style>
    /* 仅首页显示（body 的 lg:is-home 由 Swup 在切页时同步） */
    #banner-slogan {
        display: none;
        position: absolute;
        inset: 0;
        z-index: 5;            /* 在横幅图之上、底部渐隐层之下 */
        overflow: hidden;
        pointer-events: none;
    }
    body[class~="lg:is-home"] #banner-slogan {
        display: block;
    }

    /* 横幅容器高 65vh 且上移 30vh，可见部分只有下 35vh，故定位在 72% 附近 */
    .slogan-box {
        position: absolute;
        left: 50%;
        top: 72%;
        transform: translate(-50%, -50%);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 0.6rem;
        max-width: 90%;
        text-align: center;
        /* 呼吸放在外层：与子元素各自的入场动画不在同一元素上，避免 opacity 互相覆盖 */
        animation: slogan-breathe 5s ease-in-out calc(1.1s + var(--n) * 0.07s) infinite both;
    }

    /* 衬线字族：优先系统自带的中文宋体，不引外部字体（省一次网络请求，2G 小水管更稳） */
    .slogan-main {
        font-family: "Noto Serif SC", "Source Han Serif SC", "Source Han Serif CN",
            "Songti SC", "STSong", "SimSun", Georgia, "Times New Roman", serif;
        font-size: clamp(1.15rem, 3.5vw, 2.05rem);
        font-weight: 500;
        letter-spacing: 0.18em;   /* 疏排：衬线字拉开字距更有书卷气 */
        line-height: 1.5;
        color: rgb(255 255 255 / 0.96);
        /* 静态投影 + 柔光：横幅图明暗不定也能看清，且不参与动画 */
        text-shadow: 0 2px 12px rgb(0 0 0 / 0.55), 0 0 18px rgb(255 255 255 / 0.25);
    }

    /* 逐字：inline-block 才能做 transform；opacity + translateY 交给合成器 */
    .slogan-char {
        display: inline-block;
        animation: slogan-char-in 0.7s cubic-bezier(0.22, 1, 0.36, 1)
            calc(0.25s + var(--i) * 0.07s) both;
    }

    .slogan-sub {
        font-size: clamp(0.75rem, 2vw, 0.9375rem);
        letter-spacing: 0.22em;
        text-transform: uppercase;
        color: rgb(255 255 255 / 0.62);
        text-shadow: 0 1px 8px rgb(0 0 0 / 0.5);
        /* 等主标逐字动画跑完再进场 */
        animation: slogan-in 0.8s cubic-bezier(0.22, 1, 0.36, 1)
            calc(0.6s + var(--n) * 0.07s) both;
    }

    @keyframes slogan-char-in {
        from {
            opacity: 0;
            transform: translateY(0.55em);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slogan-in {
        from {
            opacity: 0;
            transform: translateY(0.75rem);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slogan-breathe {
        0%,
        100% {
            opacity: 0.78;
        }
        50% {
            opacity: 1;
        }
    }

    /* 减弱动效：不再呼吸 / 不再逐字，但标语照常静态显示 */
    @media (prefers-reduced-motion: reduce) {
        #banner-slogan,
        .slogan-box,
        .slogan-main,
        .slogan-char,
        .slogan-sub {
            animation: none;
        }
        .slogan-char,
        .slogan-sub {
            opacity: 1;
        }
    }
</style>
