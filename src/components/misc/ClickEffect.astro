---
// 全站点击特效：点击处弹出一组随机表情符号，向外飘散并淡出。
// 零依赖，使用 Web Animations API，动画结束即移除节点，尊重系统的「减少动效」设置。
---

<div id="click-effect-layer" aria-hidden="true" class="pointer-events-none fixed inset-0 z-[60] overflow-hidden"></div>

<style is:global>
    .click-particle {
        position: absolute;
        pointer-events: none;
        user-select: none;
        white-space: nowrap;
        line-height: 1;
        will-change: transform, opacity;
        /* 保证各平台都渲染成彩色 emoji，而不是黑白字形 */
        font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", sans-serif;
    }
</style>

<script>
// 表情符号池：每次点击从中随机挑选。想改内容直接增删这个数组即可
const EMOJIS = [
    "🌸", "✨", "💖", "😊", "🌟", "🎉",
    "💫", "🍀", "🦋", "🌈", "😍", "⭐",
    "🍄", "💕", "🥰", "🌷", "☀️", "🐰",
    "🌼", "🌻", "💐", "🌺", "🪻", "🪷",
    "💓", "💗", "💜", "💙", "🤍", "🧡",
    "☁️", "🌤️", "🌙", "🌠", "🎐", "🫧",
    "🐱", "🐹", "🐿️", "🦔", "🐝",
    "🎀", "🎁", "🧸", "🍬", "🍩", "🍭",
    "💌", "📮", "🪄", "🎠", "🎈", "🎇"
];
// 每次点击弹出的表情数量
const PARTICLE_COUNT = 10;

const layer = document.getElementById("click-effect-layer");

const prefersReducedMotion = () =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

function burst(x: number, y: number) {
    if (!layer) return;

    for (let i = 0; i < PARTICLE_COUNT; i++) {
        const el = document.createElement("span");
        const size = 18 + Math.random() * 12;          // 字号 18 ~ 30px
        // 主要朝上方散开，左右随机偏摆
        const angle = -Math.PI / 2 + (Math.random() - 0.5) * 1.8;
        const distance = 40 + Math.random() * 60;      // 扩散距离
        const dx = Math.cos(angle) * distance;
        const dy = Math.sin(angle) * distance;         // 负值 = 向上
        const rotation = Math.round(-40 + Math.random() * 80);
        const lift = 24 + Math.random() * 36;          // 尾段继续上浮

        el.className = "click-particle";
        el.textContent = EMOJIS[Math.floor(Math.random() * EMOJIS.length)];
        el.style.cssText = `left:${x}px;top:${y}px;font-size:${size}px`;

        layer.appendChild(el);

        const animation = el.animate(
            [
                {
                    transform: "translate(-50%, -50%) scale(0.2) rotate(0deg)",
                    opacity: 0,
                },
                {
                    transform: `translate(calc(-50% + ${dx * 0.45}px), calc(-50% + ${dy * 0.45}px)) scale(1.1) rotate(${rotation * 0.35}deg)`,
                    opacity: 1,
                    offset: 0.35,
                },
                {
                    transform: `translate(calc(-50% + ${dx}px), calc(-50% + ${dy}px)) scale(1) rotate(${rotation * 0.7}deg)`,
                    opacity: 0.9,
                    offset: 0.7,
                },
                {
                    transform: `translate(calc(-50% + ${dx * 1.15}px), calc(-50% + ${dy - lift}px)) scale(0.45) rotate(${rotation}deg)`,
                    opacity: 0,
                },
            ],
            {
                duration: 900 + Math.random() * 400,
                easing: "cubic-bezier(.2,.75,.3,1)",
            },
        );

        const remove = () => el.remove();
        animation.onfinish = remove;
        // 兜底清理，避免动画被中断时残留节点
        setTimeout(remove, 1800);
    }
}

document.addEventListener("click", (event: MouseEvent) => {
    if (!layer || prefersReducedMotion()) return;
    // 只响应鼠标左键 / 常规点击
    if (event.button !== 0) return;
    // 正在选中文字时不打断用户操作
    const selection = window.getSelection?.()?.toString() ?? "";
    if (selection.length > 0) return;

    burst(event.clientX, event.clientY);
});
</script>
