---
import BackToTop from "@components/control/BackToTop.astro";
import Footer from "@components/Footer.astro";
import BannerSlogan from "@components/misc/BannerSlogan.astro";
import Navbar from "@components/Navbar.astro";
import SideBar from "@components/widget/SideBar.astro";
import RightSidebar from "@components/widget/RightSidebar.astro";
import type { MarkdownHeading } from "astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import TOC from "../components/widget/TOC.astro";
import { siteConfig } from "../config";
import {
	BANNER_HEIGHT,
	BANNER_HEIGHT_EXTEND,
	MAIN_PANEL_OVERLAPS_BANNER_HEIGHT,
} from "../constants/constants";
import Layout from "./Layout.astro";

interface Props {
	title?: string;
	banner?: string;
	description?: string;
	lang?: string;
	setOGTypeArticle?: boolean;
	headings?: MarkdownHeading[];
}

const {
	title,
	banner,
	description,
	lang,
	setOGTypeArticle,
	headings = [],
} = Astro.props;
const hasBannerCredit =
	siteConfig.banner.enable && siteConfig.banner.credit.enable;
const hasBannerLink = !!siteConfig.banner.credit.url;

const mainPanelTop = siteConfig.banner.enable
	? `calc(${BANNER_HEIGHT}vh - ${MAIN_PANEL_OVERLAPS_BANNER_HEIGHT}rem)`
	: "5.5rem";

// 右侧第三列：文章页显示目录 TOC，非文章页显示日历热力 + 站点统计。
// 第三列在 xl（1280px）以上始终开启，内部两块由脚本按页面类型切换。
---

<Layout title={title} banner={banner} description={description} lang={lang} setOGTypeArticle={setOGTypeArticle}>

<!-- Navbar -->
<slot slot="head" name="head"></slot>
<div id="top-row" class="z-50 pointer-events-none relative transition-all duration-700 max-w-[var(--page-width)] px-0 md:px-4 mx-auto" class:list={[""]}>
    <div id="navbar-wrapper" class="pointer-events-auto sticky top-0 transition-all">
        <Navbar></Navbar>
    </div>
</div>

<!-- Banner -->
{siteConfig.banner.enable && <div id="banner-wrapper" class={`absolute z-10 w-full transition duration-700 overflow-hidden`} style={`top: -${BANNER_HEIGHT_EXTEND}vh`}>
    <ImageWrapper id="banner" alt="Banner image of the blog" class:list={["object-cover h-full transition duration-700 opacity-0 scale-105"]}
                  src={siteConfig.banner.src} position={siteConfig.banner.position}
    >
    </ImageWrapper>
    <!-- 横幅标语：仅首页显示，一行静态文字 + 缓慢呼吸辉光（纯 CSS） -->
    <BannerSlogan></BannerSlogan>
    <!-- 底部渐隐到页面底色，消除横幅图与背景之间的生硬接缝 -->
    <div id="banner-fade" aria-hidden="true" class="pointer-events-none absolute inset-0 z-10"></div>
</div>}

<!-- Main content -->
<div class="absolute w-full z-30 pointer-events-none" style={`top: ${mainPanelTop}`}>
    <!-- The pointer-events-none here prevent blocking the click event of the TOC -->
    <div class="relative max-w-[var(--page-width)] mx-auto pointer-events-auto">
        <!-- 右侧第三列始终开启：文章页放目录，非文章页放日历热力 + 站点统计 -->
        <div id="main-grid" class:list={["transition duration-700 w-full left-0 right-0 grid grid-cols-[17.5rem_auto] grid-rows-[auto_1fr_auto] lg:grid-rows-[auto] mx-auto gap-5 px-0 md:px-4",
            {"xl:grid-cols-[17.5rem_auto_13rem]": true}]}
        >
            <!-- Banner image credit -->
            {hasBannerCredit && <a href={siteConfig.banner.credit.url} id="banner-credit" target="_blank" rel="noopener" aria-label="Visit image source"
                                   class:list={["group onload-animation transition-all absolute flex justify-center items-center rounded-full " +
                                   "px-3 right-4 -top-[3.25rem] bg-black/60 hover:bg-black/70 h-9", {"hover:pr-9 active:bg-black/80": hasBannerLink}]}
            >
                <Icon class="text-white/75 text-[1.25rem] mr-1" name="material-symbols:copyright-outline-rounded" ></Icon>
                <div class="text-white/75 text-xs">{siteConfig.banner.credit.text}</div>
                <Icon class:list={["transition absolute text-[oklch(0.75_0.14_var(--hue))] right-4 text-[0.75rem] opacity-0",
                    {"group-hover:opacity-100": hasBannerLink}]}
                      name="fa6-solid:arrow-up-right-from-square">
                </Icon>
            </a>}


            <SideBar class="mb-4 row-start-2 row-end-3 col-span-2 lg:row-start-1 lg:row-end-2 lg:col-span-1 lg:max-w-[17.5rem] onload-animation" headings={headings}></SideBar>

            <main id="swup-container" class="transition-swup-fade col-span-2 lg:col-span-1 overflow-hidden">
                <div id="content-wrapper" class="onload-animation">
                    <!-- the overflow-hidden here prevent long text break the layout-->
                    <!-- make id different from windows.swup global property -->
                    <slot></slot>
                    <div class="footer col-span-2 onload-animation hidden lg:block">
                        <Footer></Footer>
                    </div>
                </div>
            </main>

            <!-- 右侧第三列：文章页显示目录 TOC，非文章页显示日历热力 + 站点统计。
                 外层 #right-panel 在 xl 以上始终占第三列；内部两块按当前页面切换显示。
                 注意：不要给 #right-panel 加 onload-animation，否则动画的 transform 会让它成为
                 sticky 的 containing block，导致内部 sticky 目录无法随视口滚动固定。 -->
            <div id="right-panel" class="toc-column">
                <div id="toc-wrapper" class="hidden h-full">
                    <div class="sticky top-[5.5rem]">
                        <div class="card-base p-2">
                            <div id="toc-inner-wrapper" data-toc-scroll class="relative max-h-[calc(100vh_-_13rem)] overflow-y-auto overflow-x-hidden hide-scrollbar">
                                <div id="toc" class="w-full h-full transition-swup-fade py-1">
                                    <TOC headings={headings}></TOC>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div id="right-sidebar-wrapper" class="hidden h-full">
                    <div class="sticky top-[5.5rem]">
                        <RightSidebar></RightSidebar>
                    </div>
                </div>
            </div>

            <!-- #toc 必须始终存在，否则 Swup 无法正常工作 -->
            {!siteConfig.toc.enable && <div id="toc" class="hidden"></div>}

            <div class="footer col-span-2 onload-animation block lg:hidden">
                <Footer></Footer>
            </div>
        </div>

        <BackToTop></BackToTop>
    </div>
</div>

<script>
// 右侧第三列始终存在（Swup 只替换 main 和 #toc 的内容，外层栅格不会重建）。
// 文章页显示目录 TOC，非文章页显示日历热力 + 站点统计，靠脚本在两者间切换。
function syncTocLayout() {
    const toc = document.getElementById("toc");
    const tocWrapper = document.getElementById("toc-wrapper");
    const rightSidebar = document.getElementById("right-sidebar-wrapper");
    if (!toc) return;

    // 判断是否有真实目录：检查 <table-of-contents> 元素是否存在。
    // 注意不能用 toc.children.length，因为 #toc 里始终有一个 TOC 组件的 <script> 标签，
    // 会导致非文章页也误判为「有目录」。
    const hasTOC = !!toc.querySelector("table-of-contents");
    if (tocWrapper) tocWrapper.classList.toggle("hidden", !hasTOC);
    if (rightSidebar) rightSidebar.classList.toggle("hidden", hasTOC);
}

syncTocLayout();
// Swup 完成页面切换后触发（首次加载不会触发，故上面先执行一次）
document.addEventListener("astro:after-swap", syncTocLayout);
document.addEventListener("astro:page-load", syncTocLayout);
</script>

</Layout>
